# Database configuration (Defaults to SQLite for local development/testing if PostgreSQL is not running)
DATABASE_URL=sqlite:///./exit_feedback.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/exit_feedback

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment
ENVIRONMENT=development
